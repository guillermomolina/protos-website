{
  "name": "Protos Website",
  "build": {
    "dockerfile": "Dockerfile",
    "context": ".."
  },
  "workspaceFolder": "/workspaces/protos-website",
  "remoteUser": "node",
  "mounts": [
    "source=protos-website-devcontainer-node_modules,target=/workspaces/protos-website/node_modules,type=volume",
    "source=${localEnv:HOME}/.claude,target=/home/node/.claude,type=bind",
    "source=${localEnv:HOME}/.claude.json,target=/home/node/.claude.json,type=bind"
  ],
  "postCreateCommand": "npm ci",
  "customizations": {
    "vscode": {
      "extensions": [
        "astro-build.astro-vscode",
        "anthropic.claude-code"
      ]
    }
  }
}
