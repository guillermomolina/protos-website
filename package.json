{
  "name": "protos-website",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "prepare:protos": "node scripts/prepare-protos.mjs && node scripts/prepare-vscode-grammar.mjs && node scripts/materialize-protos-browser-grammar.mjs",
    "source:check": "node scripts/prepare-protos.mjs --check && node scripts/prepare-vscode-grammar.mjs --check",
    "source:update": "node scripts/update-protos-source.mjs",
    "predev": "npm run prepare:protos",
    "dev": "astro dev --host 0.0.0.0",
    "prebuild": "npm run prepare:protos",
    "build": "astro build",
    "preview": "astro preview --host 0.0.0.0",
    "release:check": "node scripts/check-protos-release.mjs",
    "check": "npm run source:check && npm run release:check"
  },
  "dependencies": {
    "@astrojs/starlight": "0.42.0",
    "@shikijs/themes": "4.4.3",
    "astro": "7.3.2",
    "rehype-sanitize": "6.0.0",
    "rehype-stringify": "10.0.1",
    "remark-gfm": "4.0.1",
    "remark-parse": "11.0.0",
    "remark-rehype": "11.1.2",
    "shiki": "4.4.3",
    "unified": "11.0.5"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
