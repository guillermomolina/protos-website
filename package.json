{
  "name": "protos-website",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "prepare:protos": "node scripts/prepare-protos.mjs",
    "source:check": "node scripts/prepare-protos.mjs --check",
    "source:update": "node scripts/update-protos-source.mjs",
    "predev": "npm run prepare:protos",
    "dev": "astro dev --host 0.0.0.0",
    "prebuild": "npm run prepare:protos",
    "build": "astro build",
    "preview": "astro preview --host 0.0.0.0"
  },
  "dependencies": {
    "@astrojs/starlight": "0.42.0",
    "astro": "7.3.2"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
