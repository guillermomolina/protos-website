---
import '../styles/home.css';
import { nativeFirstRun, portableFirstRun } from '../scripts/release-onboarding.js';

const brandLogo = '/protos-branding/protos-logo.png';

const navigation = [
  { label: 'Learn', href: '/docs/live/' },
  { label: 'Reference', href: '/reference/' },
  { label: 'Design', href: '/design/' },
  { label: 'Community', href: '/community/' },
];

const principles = [
  {
    title: 'One object-and-slot model',
    body:
      'Ordinary object state, module bindings, and lexical bindings all use slots instead of unrelated storage concepts.',
  },
  {
    title: 'Creation is not modification',
    body:
      'The language keeps intent explicit: : creates a slot, while = modifies an existing eligible slot.',
  },
  {
    title: 'Closures are the executable value',
    body:
      'Methods are an invocation role of closures, not a second callable value category.',
  },
  {
    title: 'Scale by composition',
    body:
      'Futures, structured tasks, isolated parallel execution, and Actors extend the same object/message/closure universe.',
  },
];

const canonicalRepository = 'https://github.com/guillermomolina/protos';
const releasesPage = `${canonicalRepository}/releases`;
const canonicalSite = 'https://protos.guillermomolina.com/';
const socialImage = 'https://protos.guillermomolina.com/icon-512x512.png';
const socialDescription =
  'Protos is an experimental prototype-based programming language built from a small set of composable mechanisms.';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1.0"
    />
    <meta
      name="description"
      content={socialDescription}
    />
    <link rel="canonical" href={canonicalSite} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Protos" />
    <meta
      property="og:title"
      content="Protos — Experimental prototype-based programming language"
    />
    <meta property="og:description" content={socialDescription} />
    <meta property="og:url" content={canonicalSite} />
    <meta property="og:image" content={socialImage} />
    <meta
      property="og:image:alt"
      content="Protos programming language"
    />
    <meta property="og:image:width" content="512" />
    <meta property="og:image:height" content="512" />
    <meta name="twitter:card" content="summary" />
    <meta
      name="twitter:title"
      content="Protos — Experimental prototype-based programming language"
    />
    <meta name="twitter:description" content={socialDescription} />
    <meta name="twitter:image" content={socialImage} />
    <meta name="twitter:image:alt" content="Protos programming language" />
    <meta name="theme-color" content="#f7fafc" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <script
      defer
      src="https://stats.guillermomolina.com/script.js"
      data-website-id="16bfc4d7-f72e-488e-b153-3466acf8d1c3"
      data-domains="protos.guillermomolina.com"
    ></script>
    <title>Protos — Experimental prototype-based programming language</title>
  </head>
  <body>
    <header class="site-header">
      <div class="shell header-inner">
        <a class="brand" href="/" aria-label="Protos home">
          <img class="brand-logo" src={brandLogo} alt="" />
        </a>

        <nav class="primary-nav" aria-label="Primary navigation">
          {
            navigation.map((item) => (
              <a href={item.href}>{item.label}</a>
            ))
          }
          <a
            class="github-link"
            href={canonicalRepository}
            rel="noreferrer"
          >
            GitHub
          </a>
        </nav>
      </div>
    </header>

    <main>
      <section class="hero">
        <div class="shell hero-grid">
          <div class="hero-copy">
            <p class="eyebrow">Experimental prototype-based programming language</p>
            <h1>A small set of composable mechanisms.</h1>
            <p class="hero-lede">
              Protos is built around objects, slots, delegation, messages,
              execution contexts, closures, Futures, and Actors. There are no
              classes: objects delegate directly to other objects.
            </p>

            <div class="maturity" aria-label="Project maturity">
              <span>Core language: v0.1 draft</span>
              <span>Reference implementation: active development</span>
              <span data-live-release="version" aria-live="polite">Latest published prerelease</span>
            </div>

            <div class="hero-actions">
              <a class="button primary" href="#try-protos">Try Protos</a>
              <a class="button secondary" data-live-release="native"
                 href={releasesPage}>Download Native</a>
              <a class="text-action" data-live-release="notes"
                 href={releasesPage}>Releases and checksums →</a>
            </div>
            <ul class="release-notes" aria-label="Download options">
              <li>Native: Linux x86_64, no external JDK.
                  Check the current release requirements.</li>
              <li>Portable JVM:
                  <a data-live-release="portable" href={releasesPage}>
                    Download portable distribution
                  </a>. Requires the supported external GraalVM/JDK.</li>
              <li>Core language v0.1 remains experimental.</li>
            </ul>
          </div>

          <div class="code-panel" aria-label="Protos delegation example">
            <div class="code-panel-header">
              <span>Objects delegate directly</span>
              <span class="code-source">first look</span>
            </div>
            <pre><code><span class="syntax-name">animal</span>: &#123;
    <span class="syntax-name">alive</span>: <span class="syntax-value">true</span>

    <span class="syntax-name">speak</span>: () =&gt; &#123;
        <span class="syntax-call">print</span>(name)
    &#125;
&#125;

<span class="syntax-name">dog</span>: animal &#123;
    <span class="syntax-name">name</span>: <span class="syntax-string">"Rex"</span>
&#125;

dog.<span class="syntax-call">speak</span>()</code></pre>
            <p class="code-caption">
              <code>dog</code> delegates to <code>animal</code>. The inherited
              closure runs with <code>dog</code> as its receiver.
            </p>
          </div>
        </div>
      </section>

      <section id="try-protos" class="quickstart" aria-labelledby="try-title">
        <div class="shell">
          <div class="quickstart-heading">
            <p class="eyebrow">Your first program</p>
            <h2 id="try-title">Try Protos.</h2>
            <p>Copy the commands below to download the latest published
               prerelease from GitHub, verify it and run your first program.</p>
            <p>Requires curl, Python 3, unzip and sha256sum.</p>
          </div>
          <div class="quickstart-grid">
            <article class="quickstart-card">
              <h3>Native Linux x86_64 — recommended</h3>
              <p>No external JDK. Check the current release's glibc
                 and CPU requirements. Guest JIT is unavailable.</p>
              <p class="quickstart-links">
                <a data-live-release="native-archive" href={releasesPage}>Download ZIP</a>
                <a data-live-release="native-checksum" href={releasesPage}>SHA-256</a>
              </p>
              <div class="quickstart-toolbar">
                <span>Terminal</span>
                <div>
                  <button type="button" data-copy-onboarding="native">Copy commands</button>
                  <span data-copy-status role="status" aria-live="polite"></span>
                </div>
              </div>
              <pre class="quickstart-terminal"><code data-first-run="native">{nativeFirstRun}</code></pre>
            </article>
            <article class="quickstart-card">
              <h3>Portable JVM — compatibility fallback</h3>
              <p>Requires the supported external GraalVM/JDK.
                 Java is not bundled. Check the current release notes.</p>
              <p class="quickstart-links">
                <a data-live-release="portable-archive" href={releasesPage}>Download ZIP</a>
                <a data-live-release="portable-checksum" href={releasesPage}>SHA-256</a>
              </p>
              <div class="quickstart-toolbar">
                <span>Terminal</span>
                <div>
                  <button type="button" data-copy-onboarding="portable">Copy commands</button>
                  <span data-copy-status role="status" aria-live="polite"></span>
                </div>
              </div>
              <pre class="quickstart-terminal"><code data-first-run="portable">{portableFirstRun}</code></pre>
              <p>Set <code>JAVA_HOME</code> to your supported GraalVM/JDK, or select that runtime using <code>PROTOS_JAVA</code> or <code>PATH</code>. The launcher checks <code>RUNTIME.txt</code>.</p>
            </article>
          </div>
          <p class="quickstart-next">For VS Code, Dev Containers and further examples,
             <a href="/docs/live/">explore the documentation</a>.</p>
        </div>
      </section>

      <section class="thesis" aria-labelledby="why-protos">
        <div class="shell">
          <div class="section-heading">
            <p class="eyebrow">Why Protos?</p>
            <h2 id="why-protos">Fewer independent semantic rules.</h2>
            <p>
              The design aims to grow through composition rather than by adding
              a new language institution for every new capability.
            </p>
          </div>

          <div class="principle-grid">
            {
              principles.map((principle) => (
                <article class="principle">
                  <h3>{principle.title}</h3>
                  <p>{principle.body}</p>
                </article>
              ))
            }
          </div>
        </div>
      </section>

      <section class="model" aria-labelledby="model-title">
        <div class="shell model-grid">
          <div>
            <p class="eyebrow">One universe</p>
            <h2 id="model-title">Objects, slots, delegation, contexts.</h2>
          </div>
          <div class="model-copy">
            <p>
              Protos deliberately separates lexical lookup from receiver
              delegation while reusing the same slot mechanism. Reads may
              delegate; writes do not silently mutate an ancestor prototype.
            </p>
            <a href="/design/">Explore the design philosophy →</a>
          </div>
        </div>
      </section>

      <section class="latest-news" aria-labelledby="latest-news-title">
        <div class="shell">
          <div class="section-heading news-heading">
            <p class="eyebrow">Project milestones</p>
            <h2 id="latest-news-title">Latest news.</h2>
            <p>
              Official announcements from GitHub Discussions, updated
              automatically without rebuilding this website.
            </p>
          </div>

          <p data-live-news="status" role="status">
            Latest announcements are available on GitHub Discussions.
          </p>
          <div
            class="news-grid"
            data-live-news="cards"
            aria-live="polite"
          ></div>

          <a
            class="news-archive-link"
            href="https://github.com/guillermomolina/protos/discussions/categories/announcements"
            rel="noreferrer"
          >
            Browse all announcements on GitHub →
          </a>
        </div>
      </section>

      <section class="project-activity" aria-labelledby="project-activity-title">
        <div class="shell">
          <div class="section-heading project-activity-heading">
            <p class="eyebrow">GitHub project activity</p>
            <h2 id="project-activity-title">Active development.</h2>
            <p>
              Recent open Issues and workflow runs. These are sampled
              signals, not a changelog or a statement that the full
              test suite passed.
            </p>
          </div>

          <div class="project-activity-grid">
            <article class="project-signal" aria-labelledby="project-issues-title">
              <h3 id="project-issues-title">Recently updated open issues</h3>
              <p
                class="project-signal-state"
                role="status"
                aria-live="polite"
                data-project-status-state="issues"
              >Browse live issues on GitHub.</p>
              <ul
                class="project-signal-list"
                data-project-status-list="issues"
                hidden
              ></ul>
              <a
                class="project-signal-more"
                href="https://github.com/guillermomolina/protos/issues"
                rel="noreferrer"
              >View all issues on GitHub →</a>
            </article>

            <article class="project-signal" aria-labelledby="project-actions-title">
              <h3 id="project-actions-title">Recent workflow runs</h3>
              <p
                class="project-signal-state"
                role="status"
                aria-live="polite"
                data-project-status-state="actions"
              >Browse workflow runs on GitHub.</p>
              <ul
                class="project-signal-list"
                data-project-status-list="actions"
                hidden
              ></ul>
              <a
                class="project-signal-more"
                href="https://github.com/guillermomolina/protos/actions"
                rel="noreferrer"
              >View GitHub Actions →</a>
            </article>
          </div>
        </div>
      </section>

      <section class="next">
        <div class="shell next-inner">
          <div>
            <p class="eyebrow">Start here</p>
            <h2>Read, run, then go deeper.</h2>
          </div>
          <div class="next-actions">
            <a href="/docs/live/">Learn</a>
            <a href="/reference/">Reference</a>
            <a href="/community/">Community</a>
          </div>
        </div>
      </section>
    </main>

    <footer>
      <div class="shell footer-inner">
        <p>
          Protos is experimental. The canonical specification and project
          sources live in the Protos repository.
        </p>
        <a href={canonicalRepository}>GitHub</a>
      </div>
    </footer>
    <script>
      import { refreshLiveRelease } from '../scripts/live-release.js';
      import { wireOnboardingCopy } from '../scripts/release-onboarding.js';
      import { refreshLiveNews } from '../scripts/live-news.js';

      wireOnboardingCopy(document);
      void refreshLiveRelease(document, fetch);
      void refreshLiveNews(document, fetch);
    </script>
      <script>
  import '../scripts/live-project-status.js';
</script>
  </body>
</html>
