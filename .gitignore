# Repository-local scratch path. `/tmp` intentionally also matches a symlink.
# Do not change this to `/tmp/`: the checkout may contain `tmp` as a symlink.
/tmp

# Node / Astro
/node_modules
/.astro
/dist

# Exact-SHA Protos materialization. Build input only; never canonical content.
/.protos-source
/.protos-source.*

# Generated branding copied from the exact-SHA Protos source.
/public/protos-branding

# Generated Programming Guide pages rendered from the exact-SHA Protos source.
# The curated guide index stays tracked; canonical chapter/style copies do not.
/src/content/docs/learn/guide/[0-9][0-9]-*.md
/src/content/docs/learn/guide/source-style.md

# Generated tutorial group pages rendered from exact-SHA executable sources.
# The curated tutorials index stays tracked; generated groups do not.
/src/content/docs/learn/tutorials/[0-9][0-9]-*/

# Generated task catalog and executable example pages from exact-SHA source.
# The curated examples index stays tracked.
/src/content/docs/learn/examples/catalog/
/src/content/docs/learn/examples/programs/

# Generated language/specification reference from exact-SHA canonical sources.
# The curated language index stays tracked.
/src/content/docs/reference/language/specification/
/src/content/docs/reference/language/grammar/
/src/content/docs/reference/language/semantics/
/src/content/docs/reference/language/concurrency/
/src/content/docs/reference/language/io/
/src/content/docs/reference/language/runtime/

# Generated exact-SHA standard-library source browser.
# The curated standard-library index stays tracked.
/src/content/docs/reference/standard-library/source/

# Generated exact-SHA D064 Standard Library API reference.
# The curated standard-library index stays tracked.
/src/content/docs/reference/standard-library/api/

# Local/editor noise
.DS_Store
npm-debug.log*
