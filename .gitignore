# Repository-local scratch path. `/tmp` intentionally also matches a symlink.
# Do not change this to `/tmp/`: the checkout may contain `tmp` as a symlink.
/tmp

# Node / Astro
/node_modules
/.astro
/dist

# Exact-SHA Protos materialization. Build input only; never canonical content.
/.protos-source
/.protos-source.*

# Generated branding copied from the exact-SHA Protos source.
/public/protos-branding

# Generated Programming Guide pages rendered from the exact-SHA Protos source.
# The curated guide index stays tracked; canonical chapter/style copies do not.
/src/content/docs/learn/guide/[0-9][0-9]-*.md
/src/content/docs/learn/guide/source-style.md

# Local/editor noise
.DS_Store
npm-debug.log*
